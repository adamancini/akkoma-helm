# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.

# Secrets (CRITICAL - never package secrets)
secrets*.yaml
*-secrets.yaml
values.production.yaml
values.*.local.yaml

# Development files
.DS_Store
*.swp
*.bak
*.tmp
*.orig
*~

# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/

# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Documentation (included in repo, not in package)
DESIGN.md
TASKS.md
docs/
